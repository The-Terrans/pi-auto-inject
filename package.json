{
  "name": "pi-auto-inject",
  "version": "0.2.0",
  "type": "module",
  "description": "Pi extension that injects @-referenced files and AGENTS.md references into model context.",
  "author": "The Terrans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Terrans/pi-auto-inject.git"
  },
  "homepage": "https://github.com/The-Terrans/pi-auto-inject#readme",
  "bugs": {
    "url": "https://github.com/The-Terrans/pi-auto-inject/issues"
  },
  "packageManager": "pnpm@12.3.4",
  "keywords": ["pi-package", "pi-extension", "file-injection", "agents.md"],
  "files": ["extensions"],
  "scripts": {
    "dev": "pi -e ./extensions/index.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0"
  }
}
