{
  "name": "pi-auto-inject",
  "version": "0.2.0",
  "type": "module",
  "description": "Pi extension to inject @-referenced file contents into user requests.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "keywords": ["pi-package"],
  "files": ["extensions"],
  "scripts": {
    "dev": "pi -e ./extensions/index.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0"
  }
}
